# Shareable submission template. Copy to .env and fill credentials privately.
# No credential, subscription, balance or API access is included in the source ZIP.
LLM_PROVIDER=codecraft
CODECRAFT_API_KEY=
CODECRAFT_SECONDARY_API_KEYS=[]
CODECRAFT_KEY_ROUTING=balanced
MAX_MODEL_CONCURRENCY=3
MAX_RESEARCH_AGENTS=3
CODECRAFT_MODEL_RESEARCH=claude-opus-5.5
CODECRAFT_MODEL_EXTRACT=claude-opus-5.5

# Explicitly permit NVIDIA after a definitive CodeCraft credit-exhaustion rejection.
# This includes final review; the report records the provider that actually answered.
CODECRAFT_NVIDIA_FALLBACK=true
NVIDIA_API_KEY=
NVIDIA_MODEL_RESEARCH=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_EXTRACT=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_RESPONSE_FORMAT=json_schema
NVIDIA_PLANNING=false

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
# Set this to your account's actual USD cost per search credit. Use 0 only when
# requests are covered by an included allowance. Do not copy an assumed price.
# SEARCH_USD_PER_CREDIT=
FREE_SERVICES_ONLY=false
# Local accounting ceiling, not a payment or account upgrade. Set your own budget.
MAX_RUN_COST_USD=5
MODEL_RATE_CARD_PATH=./config/model-rates.json

APP_HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/signal.db
AUTO_START_WORKER=false
MAX_RUN_SECONDS=600
DEMO_TARGET_SECONDS=600
MODEL_REQUEST_TIMEOUT_SECONDS=300
SOURCE_REQUEST_TIMEOUT_SECONDS=25
PDF_PARSE_TIMEOUT_SECONDS=90
MAX_MODEL_OUTPUT_TOKENS_PER_CALL=16384
STAGE_REQUEST_SECONDS={"extracting":90,"normalizing":120,"hypothesizing":70,"challenging":70,"composing":90,"verifying":90}
STAGE_OUTPUT_TOKENS={"extracting":6144,"normalizing":8192,"hypothesizing":6144,"challenging":6144,"composing":16384,"verifying":12288}
MAX_INPUT_TOKENS=1000000
MAX_OUTPUT_TOKENS=250000
MAX_MODEL_CALLS=100
MAX_SEARCH_CALLS=60
MAX_FETCH_DOCUMENTS=60
MAX_OCR_PAGES=16
MAX_FETCH_CONCURRENCY=3
MAX_ACTIVE_RUNS=1

# Leave the command name on WSL/Linux. On Windows, set the installed executable's
# full path if tesseract.exe is not already on PATH.
TESSERACT_PATH=tesseract
