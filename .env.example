# Shareable template: copy this file to .env and enter your own API keys.

# AI provider
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL_RESEARCH=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b

# Web search
TAVILY_API_KEY=
# Included free allowance only; paid overage is never enabled.
SEARCH_USD_PER_CREDIT=0
# Advanced search consumes two included credits per request.
TAVILY_SEARCH_DEPTH=advanced
FREE_SERVICES_ONLY=true
MAX_RUN_COST_USD=0

# Local application (scripts/local.ps1 starts the separate worker)
APP_HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/signal.db

# Provisional eight-minute research target
MAX_RUN_SECONDS=480
MODEL_REQUEST_TIMEOUT_SECONDS=90
PDF_PARSE_TIMEOUT_SECONDS=45
# Windows OCR installer location; adjust on other operating systems.
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# Free-tier per-run safety caps (provider account quotas are separate).
MAX_INPUT_TOKENS=100000
MAX_OUTPUT_TOKENS=12000
MAX_MODEL_CALLS=16
MAX_MODEL_OUTPUT_TOKENS_PER_CALL=4096
MAX_SEARCH_CALLS=14
MAX_FETCH_DOCUMENTS=16

# Copy the matching account rate card here; see README.md.
MODEL_RATE_CARD_PATH=./config/model-rates.json
