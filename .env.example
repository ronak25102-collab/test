APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DISPLAY_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql+psycopg://signal:signal@db:5432/signal
DATA_DIR=./data
LLM_PROVIDER=openai
# For Gemini use LLM_PROVIDER=gemini and configure both Gemini model roles.
GEMINI_API_KEY=
GEMINI_MODEL_RESEARCH=gemini-3.8-flash
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_EXTRACT=
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
RESEARCH_MODE=live
MAX_RUN_SECONDS=420
MAX_SEARCH_CALLS=30
MAX_FETCH_DOCUMENTS=30
MAX_MODEL_CALLS=50
MAX_OCR_PAGES=8
MAX_FETCH_CONCURRENCY=3
MAX_ACTIVE_RUNS=1
MAX_INPUT_TOKENS=150000
MAX_OUTPUT_TOKENS=20000
MAX_MODEL_OUTPUT_TOKENS_PER_CALL=8192
MAX_RUN_COST_USD=5.00
MODEL_RATE_CARD_PATH=./config/model-rates.json
SOURCE_REQUEST_TIMEOUT_SECONDS=25
MAX_SOURCE_BYTES=25000000
ALLOW_FIXTURE_PROVIDER=false
ALLOW_UNKNOWN_COST=false
AUTO_START_WORKER=false
PDFTOPPM_PATH=pdftoppm
TESSERACT_PATH=tesseract
# Set the rate for your Tavily plan to enforce the dollar budget.
# SEARCH_USD_PER_CREDIT=0.008
