# Shareable template: copy this file to .env and enter your own API keys.

# Stored evidence playback needs no API keys or model rate card.
# Set PIPELINE_MODE=live to use the original provider-backed pipeline.
PIPELINE_MODE=precomputed
REPLAY_DURATION_SECONDS=120

# AI provider
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL_RESEARCH=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b
NVIDIA_RESPONSE_FORMAT=json_object

# Web search
# Optional CodeCraft provider: set LLM_PROVIDER=codecraft and both model roles.
# CODECRAFT_API_KEY=
# CODECRAFT_MODEL_RESEARCH=gemini-3.7-flash
# CODECRAFT_MODEL_EXTRACT=gemini-3.7-flash
# Backups are tried only after an explicit HTTP 402 credit-exhaustion rejection.
# JSON array; credentials belong only in your private .env.
CODECRAFT_SECONDARY_API_KEYS=[]
CODECRAFT_NVIDIA_FALLBACK=false
# Independent runtime agents may distribute work across configured keys.
# Balanced routing caps one in-flight request per key and never rotates on 429.
CODECRAFT_KEY_ROUTING=balanced
MAX_MODEL_CONCURRENCY=3
MAX_RESEARCH_AGENTS=3
FAST_VERIFIED_PROPOSALS=true

TAVILY_API_KEY=
# Included free allowance only; paid overage is never enabled.
SEARCH_USD_PER_CREDIT=0
# Advanced search consumes two included credits per request.
TAVILY_SEARCH_DEPTH=advanced
FREE_SERVICES_ONLY=true
MAX_RUN_COST_USD=0

# Local application (scripts/local.ps1 starts the separate worker)
APP_HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/signal.db

# Extended research allowances; these are ceilings, not target usage.
MAX_RUN_SECONDS=600
DEMO_TARGET_SECONDS=600
MODEL_REQUEST_TIMEOUT_SECONDS=900
SOURCE_REQUEST_TIMEOUT_SECONDS=45
PDF_PARSE_TIMEOUT_SECONDS=180
# Windows OCR installer location; adjust on other operating systems.
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# Per-run safety caps (provider account quotas are separate).
MAX_INPUT_TOKENS=5000000
MAX_OUTPUT_TOKENS=5000000
MAX_MODEL_CALLS=200
# Includes reasoning tokens where reported; used by extraction and review too.
MAX_MODEL_OUTPUT_TOKENS_PER_CALL=65536
MAX_SEARCH_CALLS=100
MAX_FETCH_DOCUMENTS=100
MAX_OCR_PAGES=50
# For CodeCraft/paid services, set FREE_SERVICES_ONLY=false and raise the ceiling:
# MAX_RUN_COST_USD=100

# Copy the matching account rate card here; see README.md.
# CodeCraft Gemini Flash + NVIDIA Lightning: config/model-rates.codecraft.example.json
# NVIDIA Super only: config/model-rates.nvidia-free.example.json
MODEL_RATE_CARD_PATH=./config/model-rates.json

# NVIDIA extraction/planning; final review first uses configured provider, then explicit authorized fallbacks.
NVIDIA_PLANNING=false
