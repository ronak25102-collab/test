# Shareable template: copy this file to .env and enter your own API keys.

# AI provider
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL_RESEARCH=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_EXTRACT=nvidia/nemotron-3.5-lightning-30b-a3b

# Web search
TAVILY_API_KEY=
# Example cost estimate; adjust for your Tavily plan.
SEARCH_USD_PER_CREDIT=0.008

# Local application (scripts/local.ps1 starts the separate worker)
APP_HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/signal.db

# Longer limits for NVIDIA research runs
MAX_RUN_SECONDS=900
MODEL_REQUEST_TIMEOUT_SECONDS=300

# Copy the matching account rate card here; see README.md.
MODEL_RATE_CARD_PATH=./config/model-rates.json
