APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DISPLAY_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql+psycopg://signal:signal@db:5432/signal
DATA_DIR=./data
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_EXTRACT=
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
RESEARCH_MODE=live
MAX_RUN_SECONDS=420
MAX_SEARCH_CALLS=30
MAX_FETCH_DOCUMENTS=30
MAX_MODEL_CALLS=50
MAX_OCR_PAGES=8
MAX_FETCH_CONCURRENCY=3
MAX_ACTIVE_RUNS=1
MAX_INPUT_TOKENS=150000
MAX_OUTPUT_TOKENS=20000
MAX_RUN_COST_USD=5.00
MODEL_RATE_CARD_PATH=./config/model-rates.json
SOURCE_REQUEST_TIMEOUT_SECONDS=25
MAX_SOURCE_BYTES=25000000
ALLOW_FIXTURE_PROVIDER=false
ALLOW_UNKNOWN_COST=false
AUTO_START_WORKER=true
